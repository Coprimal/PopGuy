<?xml version="1.0" encoding="utf-8"?>
<!--
    The Terminal Composer window (macOS ComposerWindow.swift + ComposerView.swift): a find bar (hidden until Ctrl+F),
    the plain-text editor with the command suggestions over it, the image strip, a footer with the source hint, the
    notices and the buttons, and the image preview overlay. The editor's highlighting, the suggestions and the keys are
    in ComposerWindow.xaml.cs; the image strip and preview in ComposerWindow.Images.cs.
-->
<Window
    x:Class="PopGuy.Composer.ComposerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PopGuy.Controls"
    Title="PopGuy Composer">

    <!-- The solid base background, as the Settings window (never Mica, which takes a tint from the wallpaper). -->
    <Grid x:Name="RootGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.Resources>
            <!-- The suggestion rows (built in code): the selected row's subtle fill and accent pill, as a list's selection. -->
            <Style x:Key="SuggestionHighlightStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
            <Style x:Key="SuggestionPillStyle" TargetType="Rectangle">
                <Setter Property="Width" Value="3" />
                <Setter Property="Height" Value="16" />
                <Setter Property="RadiusX" Value="1.5" />
                <Setter Property="RadiusY" Value="1.5" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="SuggestionNameStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="12,0,12,0" />
                <Setter Property="MaxWidth" Value="200" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
            <Style x:Key="SuggestionDescriptionStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,12,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Find bar: Enter is next, Shift+Enter previous, Esc closes it. -->
        <Grid
            x:Name="FindBar"
            Grid.Row="0"
            Padding="12,8,12,8"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="6"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="FindBox"
                ContextFlyout="{x:Null}"
                IsSpellCheckEnabled="False"
                IsTextPredictionEnabled="False"
                PlaceholderText="Find"
                SelectionFlyout="{x:Null}" />
            <TextBlock
                x:Name="FindStatus"
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="No matches"
                Visibility="Collapsed" />
            <Button
                x:Name="FindPreviousButton"
                Grid.Column="2"
                Style="{StaticResource SubtleButtonStyle}">
                <FontIcon FontSize="12" Glyph="&#xE70E;" />
            </Button>
            <Button
                x:Name="FindNextButton"
                Grid.Column="3"
                Style="{StaticResource SubtleButtonStyle}">
                <FontIcon FontSize="12" Glyph="&#xE70D;" />
            </Button>
            <Button
                x:Name="FindCloseButton"
                Grid.Column="4"
                Style="{StaticResource SubtleButtonStyle}">
                <FontIcon FontSize="12" Glyph="&#xE711;" />
            </Button>
        </Grid>

        <!-- Plain text only: no formatting shortcuts, no rich copy, no context or selection menu (their AppBarButtons
             attach default tooltips); the window background shows through in every state. -->
        <RichEditBox
            x:Name="Editor"
            Grid.Row="1"
            Padding="16,12,16,12"
            BorderThickness="0"
            ClipboardCopyFormat="PlainText"
            ContextFlyout="{x:Null}"
            DisabledFormattingAccelerators="All"
            FontFamily="Segoe UI"
            IsSpellCheckEnabled="False"
            IsTextPredictionEnabled="False"
            SelectionFlyout="{x:Null}"
            SelectionHighlightColorWhenNotFocused="{ThemeResource TextControlSelectionHighlightColor}"
            TextWrapping="Wrap">
            <RichEditBox.Resources>
                <StaticResource x:Key="TextControlBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="SubtleFillColorTransparentBrush" />
                <StaticResource x:Key="TextControlBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="SubtleFillColorTransparentBrush" />
            </RichEditBox.Resources>
        </RichEditBox>

        <!-- The command suggestions (CLI sessions): a list at the caret, placed and filled in code. The canvas has no
             background, so clicks outside the list reach the editor; nothing in it takes the focus or a tooltip, and
             the names and descriptions are plain text. -->
        <Canvas
            x:Name="SuggestionCanvas"
            Grid.Row="1"
            AllowFocusOnInteraction="False"
            IsTabStop="False">
            <Border
                x:Name="SuggestionPopup"
                Padding="4"
                AllowFocusOnInteraction="False"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                IsTabStop="False"
                Visibility="Collapsed">
                <ScrollViewer
                    x:Name="SuggestionScroll"
                    AllowFocusOnInteraction="False"
                    HorizontalScrollBarVisibility="Disabled"
                    IsTabStop="False"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        x:Name="SuggestionList"
                        AllowFocusOnInteraction="False"
                        IsTabStop="False" />
                </ScrollViewer>
            </Border>
        </Canvas>

        <!-- The image strip: a thumbnail per @image mention and a chip per Claude Code [Image #N], built in
             ComposerWindow.Images.cs; hidden while the text names no image. Aligned with the footer's padding. -->
        <Border
            x:Name="ImageStripHost"
            Grid.Row="2"
            Padding="16,8,16,8"
            Visibility="Collapsed">
            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Auto"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <StackPanel
                    x:Name="ImageStrip"
                    Orientation="Horizontal"
                    Spacing="8" />
            </ScrollViewer>
        </Border>

        <Grid
            Grid.Row="3"
            Padding="16,10,16,10"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                x:Name="SessionEndedNotice"
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Margin="0,0,0,8"
                Orientation="Horizontal"
                Spacing="6"
                Visibility="Collapsed">
                <FontIcon
                    FontSize="14"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Glyph="&#xE7BA;" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="The terminal session ended. Copy the text to keep it."
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel
                x:Name="TooLargeNotice"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,0,0,8"
                Orientation="Horizontal"
                Spacing="6"
                Visibility="Collapsed">
                <FontIcon
                    FontSize="14"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Glyph="&#xE7BA;" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Text is too large (max 1 MB)."
                    TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock
                x:Name="SourceHint"
                Grid.Row="2"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Compose"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <StackPanel
                Grid.Row="2"
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="RestoreDraftButton"
                    Content="Restore draft"
                    Style="{StaticResource SubtleButtonStyle}"
                    Visibility="Collapsed" />
                <Button x:Name="CancelButton" Content="Cancel" />
                <Button
                    x:Name="DoneButton"
                    Content="Done"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="DoneSubmitButton" Content="Done &amp; Submit" />
            </StackPanel>
        </Grid>

        <!-- The image preview: an in-window overlay over every row (last child, so its scrim covers the strip and the
             footer), with a card holding the large image, its file name and a close button. The image area keeps its
             size while the image loads; the ring fades in from code after a short delay. Opened and closed in
             ComposerWindow.Images.cs, which sizes the image area to the window (no minimum here: the card must fit a
             window at its minimum size; the margin and padding are mirrored there). -->
        <Grid
            x:Name="ImagePreview"
            Grid.Row="0"
            Grid.RowSpan="4"
            Visibility="Collapsed">
            <Border x:Name="ImagePreviewScrim" Background="{ThemeResource SmokeFillColorDefaultBrush}" />
            <Border
                Margin="24"
                Padding="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="ImagePreviewCaption"
                        Grid.Row="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <controls:HandCursorButton
                        x:Name="ImagePreviewClose"
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </controls:HandCursorButton>

                    <Grid
                        x:Name="ImagePreviewArea"
                        Grid.Row="1"
                        Grid.ColumnSpan="2">
                        <Image x:Name="ImagePreviewImage" Stretch="Uniform" />
                        <ProgressRing
                            x:Name="ImagePreviewRing"
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsActive="True"
                            Opacity="0" />
                        <TextBlock
                            x:Name="ImagePreviewError"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Can't show this image"
                            Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
